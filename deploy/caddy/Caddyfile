# Public edge for the Iron-Spyder desk.
#
# The engine binds 127.0.0.1 and must stay that way: it exposes
# POST /risk/kill-switch, /paper/orders, /paper/close, /models/reload and
# /scenario. Anyone who can reach those can disarm the risk engine or push
# orders into the paper book.
#
# Allowlist rule: a new endpoint is unreachable until added here on purpose.
# Desk mutations are limited to /optimize/run and /optimize/schedule — they
# only enqueue backtest jobs under the state root and never touch the live book.

{$SPYDER_PUBLIC_DOMAIN} {
	encode gzip

	@engine_get {
		method GET
		path /health /market/current /analytics/* /forecast/* /positions /performance
	}

	@desk_get {
		method GET
		path /journal /optimize /optimize/*
	}

	@desk_post {
		method POST
		path /optimize/run /optimize/schedule
	}

	@authorized header Authorization "Bearer {$SPYDER_API_TOKEN}"

	handle @engine_get {
		handle @authorized {
			reverse_proxy api:8000 {
				header_up X-Forwarded-Proto {scheme}
			}
		}
		respond "unauthorized" 401
	}

	handle @desk_get {
		handle @authorized {
			reverse_proxy status-api:8788 {
				header_up X-Forwarded-Proto {scheme}
			}
		}
		respond "unauthorized" 401
	}

	handle @desk_post {
		handle @authorized {
			reverse_proxy status-api:8788 {
				header_up X-Forwarded-Proto {scheme}
			}
		}
		respond "unauthorized" 401
	}

	# Everything else, including every dangerous engine POST.
	handle {
		respond "not exposed" 404
	}

	log {
		output stdout
		format console
	}
}
