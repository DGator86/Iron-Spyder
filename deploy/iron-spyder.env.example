# Iron-Spyder environment — install to /etc/iron-spyder/iron-spyder.env
# (mode 0640, root:iron-spyder) on the dedicated CPU VPS only.
#
# Secrets live here and nowhere else. Never commit real values.
# Never point these paths at a legacy SPY-DER or 0DTE state tree.

# ---------------------------------------------------------------------------
# State and configuration (Iron-Spyder isolation)
# ---------------------------------------------------------------------------
IRON_SPYDER_STATE_ROOT=/var/lib/iron-spyder
IRON_SPYDER_CONFIG=/etc/iron-spyder/config.yaml

# ---------------------------------------------------------------------------
# Market data — the difference between a real system and a demo
# ---------------------------------------------------------------------------
# Leave TRADIER_ACCESS_TOKEN empty and the supervisor runs the synthetic
# generator, logging a WARNING on every start that its prices are invented.
#
# Set it and the supervisor goes live — and refuses to start if the token is
# rejected, rather than falling back. A daemon that looks healthy while trading
# a seeded random walk is the one failure mode nobody thinks to check for.
#
# `systemctl status iron-spyder` shows which one you got: either the synthetic
# warning or "market data: Tradier production reachable; SPY last=...".
TRADIER_ACCESS_TOKEN=
TRADIER_ENDPOINT=production      # or `sandbox` — delayed, no greeks, IV solved locally
TRADIER_EXPIRATIONS=3            # nearest N expirations per snapshot (0DTE needs >=1)

# Declared for a future provider; nothing reads it yet.
MASSIVE_API_KEY=

# ---------------------------------------------------------------------------
# Execution — live is opt-in and fails closed
# ---------------------------------------------------------------------------
IRON_SPYDER_MODE=paper
IRON_SPYDER_ALLOW_LIVE=0
IRON_SPYDER_INTERVAL_MINUTES=5

# ---------------------------------------------------------------------------
# Compute — CPU only. Do not set CUDA/NVIDIA variables on this host.
# ---------------------------------------------------------------------------
CUDA_VISIBLE_DEVICES=
NVIDIA_VISIBLE_DEVICES=void

# ---------------------------------------------------------------------------
# Public read-only edge (optional) — lets a hosted dashboard read this engine
# ---------------------------------------------------------------------------
# Leave both empty and nothing is exposed: the stack stays loopback-only and
# `docker compose up` never starts the proxy.
#
# To expose the READ endpoints (and only those) for a Vercel dashboard:
#   1. Point a DNS A record at this host (custom domain) OR use the Hostinger
#      hostname assigned to the VPS (e.g. srvNNNN.hstgr.cloud).
#   2. SPYDER_PUBLIC_DOMAIN=<that hostname>
#   3. SPYDER_API_TOKEN=$(openssl rand -hex 32)
#   4. docker compose --profile public up -d proxy
#   5. In the Vercel project **iron-spyder** (https://iron-spyder.vercel.app),
#      set SPYDER_API_BASE=https://<same hostname> and SPYDER_API_TOKEN to the
#      same value. Neither gets a NEXT_PUBLIC_ prefix — they are read
#      server-side by the BFF, so the token never reaches a browser.
#
# Canonical dashboard URL: https://iron-spyder.vercel.app
# Do not use spy-der.vercel.app — that is a different, legacy project.
#
# The proxy allowlists GET on /health, /market/current, /analytics/*,
# /forecast/*, /positions and /performance. Every POST is refused with 404 even
# with a valid token, so /risk/kill-switch and /paper/orders stay unreachable.
SPYDER_PUBLIC_DOMAIN=
SPYDER_API_TOKEN=

# ---------------------------------------------------------------------------
# Pull-based self-update pin (iron-spyder-update.timer)
# ---------------------------------------------------------------------------
# self-update.sh reads these from this file. Leave unset to track `main`.
# Pinning a feature branch without also setting these (or exporting them for
# the timer unit) makes the timer silently redeploy `main` every poll and undo
# the pin — which is how production can snap back to synthetic SPY ~550.
# DEPLOY_BRANCH=main
# DEPLOY_REF=origin/main
