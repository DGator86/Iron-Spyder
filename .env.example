# Iron-Spyder Compose env — copy to `.env` on the dedicated CPU VPS.
# Never commit real secrets. Never point this host at SPY-DER/0DTE state trees.

IRON_SPYDER_MODE=paper
IRON_SPYDER_ALLOW_LIVE=0
IRON_SPYDER_INTERVAL_MINUTES=5

# Market-data providers (optional; supervisor falls back to synthetic)
TRADIER_ACCESS_TOKEN=
MASSIVE_API_KEY=

# Live VPS resource soft-caps (8-vCPU / 32 GB host)
IRON_SPYDER_SUPERVISOR_CPUS=2.0
IRON_SPYDER_SUPERVISOR_MEM=8g
IRON_SPYDER_API_CPUS=1.5
IRON_SPYDER_API_MEM=4g
IRON_SPYDER_DASHBOARD_CPUS=1.0
IRON_SPYDER_DASHBOARD_MEM=2g
IRON_SPYDER_STATUS_CPUS=0.5
IRON_SPYDER_STATUS_MEM=512m

# Research worker only (docker-compose.research.yml on a second CPU box)
IRON_SPYDER_RESEARCH_THREADS=16
IRON_SPYDER_RESEARCH_CPUS=8.0
IRON_SPYDER_RESEARCH_MEM=32g
IRON_SPYDER_RESEARCH_DATA=./data
IRON_SPYDER_RESEARCH_OUT=./var/research
